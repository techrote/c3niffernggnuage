# Reproducible project defaults for ESP-IDF v5.5.5.
# The target itself is selected explicitly with `idf.py set-target esp32c3`.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# One-millisecond scheduler polling; this is not an airtime-accuracy claim.
CONFIG_FREERTOS_HZ=1000

# NGN-004 passive BLE observer. Keep this list ESP32-C3-specific; the
# ESP32-only BTDM_CTRL_MODE_* selectors are not defined for C3 in v5.5.5.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=n
CONFIG_BT_NIMBLE_GATT_SERVER=n
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_HOST_ALLOW_CONNECT_WITH_SCAN=n
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_HOST_QUEUE_CONG_CHECK=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# NGN-003 CSI support in the pinned ESP-IDF v5.5.5 Wi-Fi driver.
CONFIG_ESP_WIFI_CSI_ENABLED=y
